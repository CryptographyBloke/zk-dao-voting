@@ -1,35 +1,120 @@
-const { buildBabyjub } = require("circomlibjs");
+// ============================================================================
+//  真实 DAO 数据全量并行验证（child_process 版）
+//  与 scripts/replay_harness.js 同一套密码学逻辑，但把 18 个提案按区间切分，
